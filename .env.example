# CLI 与本地 Web 平台共用这一份根目录配置；复制为 .env 后按本机情况修改。
IGG_EXE=C:\ProgramData\NUMECA\fine171\bin64\iggx86_64.exe

# 相对路径以仓库根目录为基准；生产部署建议通过系统环境变量改到 C:\ProgramData。
MESH_DATA_DIR=runs\platform-dev
MESH_DATABASE_PATH=runs\platform-dev\mesh.sqlite3
MESH_MAX_UPLOAD_BYTES=536870912
MESH_SQLITE_BUSY_TIMEOUT_MS=5000

MESH_MAX_CONCURRENCY=20
MESH_MEMORY_RESERVATION_GB=2.5
MESH_MIN_FREE_MEMORY_GB=8
MESH_MIN_FREE_DISK_GB=20
MESH_JOB_TIMEOUT_SECONDS=1800
MESH_WORKER_STALE_SECONDS=30

# 共享密码登录（可选）：两个变量必须同时设置；生成命令见下两行注释。
# platform\.venv\Scripts\python.exe -m mesh_app.auth
# 登录保持 7 天；未配置时鉴权关闭，行为与现状一致。
# MESH_AUTH_USERNAME=mesh
# MESH_AUTH_PASSWORD_HASH=scrypt$32768$8$1$<salt_hex>$<hash_hex>
