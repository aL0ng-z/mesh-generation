# ==========================================================================
# 根目录统一配置：网格 CLI（src/mesh.py）与本地 Web 平台（run-local.ps1）共用。
# 复制为 .env 后按本机情况修改；.env 不纳入版本管理。
# 相对路径一律以仓库根目录为基准；生产部署建议改到 C:\ProgramData 等仓库外目录。
# ==========================================================================

# --------------------------------------------------------------------------
# IGG / AutoGrid 可执行文件
# CLI 按 --igg > IGG_EXE > IGG_PATH > PATH 顺序解析；
# run-local.ps1 会把 IGG_EXE/IGG_PATH 复用为平台 MESH_IGG_PATH。
# --------------------------------------------------------------------------
IGG_EXE=C:\ProgramData\NUMECA\fine171\bin64\iggx86_64.exe

# --------------------------------------------------------------------------
# 数据目录与数据库
# MESH_DATA_DIR：几何、产物、预览、备份与日志的根目录（默认 C:\ProgramData\MeshExperience）
# MESH_DATABASE_PATH：SQLite 数据库文件；不设置时默认位于 MESH_DATA_DIR 下
# --------------------------------------------------------------------------
MESH_DATA_DIR=runs\platform-dev
MESH_DATABASE_PATH=runs\platform-dev\mesh.sqlite3

# .geomTurbo 上传大小上限（字节）；默认 512 MiB
MESH_MAX_UPLOAD_BYTES=536870912

# SQLite busy_timeout（毫秒）：API 与 Worker 并发读写时的锁等待上限
MESH_SQLITE_BUSY_TIMEOUT_MS=5000

# --------------------------------------------------------------------------
# Worker 资源与调度
# MESH_MAX_CONCURRENCY：Worker 硬上限，不得超过 20
# MESH_MEMORY_RESERVATION_GB：每个待领取任务的内存预留
# MESH_MIN_FREE_MEMORY_GB / MESH_MIN_FREE_DISK_GB：领取任务前的空闲资源门限
# MESH_JOB_TIMEOUT_SECONDS：单个网格任务超时（秒）
# MESH_WORKER_STALE_SECONDS：Worker 心跳超过该秒数视为离线，触发运行恢复
# --------------------------------------------------------------------------
MESH_MAX_CONCURRENCY=20
MESH_MEMORY_RESERVATION_GB=2.5
MESH_MIN_FREE_MEMORY_GB=8
MESH_MIN_FREE_DISK_GB=20
MESH_JOB_TIMEOUT_SECONDS=1800
MESH_WORKER_STALE_SECONDS=30

# --------------------------------------------------------------------------
# 后处理与预览
# MESH_POSTPROCESS_TIMEOUT_SECONDS：单个后处理子进程（产物散列登记+预览转换）超时（秒）
# MESH_PREVIEW_MEMORY_BUDGET_MB：切片生成前的工作内存预算（MiB）
# MESH_PREVIEW_CACHE_LIMIT_MB：每个运行的切片磁盘缓存上限（MiB）
# --------------------------------------------------------------------------
MESH_POSTPROCESS_TIMEOUT_SECONDS=600
MESH_PREVIEW_MEMORY_BUDGET_MB=512
MESH_PREVIEW_CACHE_LIMIT_MB=1024

# --------------------------------------------------------------------------
# 共享密码登录（可选）
# 两个变量必须同时设置才启用；任一缺失时鉴权关闭，内网用户可直接访问。
# 哈希生成命令（交互输入两次明文，不落盘）：
#   platform\.venv\Scripts\python.exe -m mesh_app.auth
# 登录态保持 7 天；修改密码后所有已登录用户立即下线。
# --------------------------------------------------------------------------
# MESH_AUTH_USERNAME=mesh
# MESH_AUTH_PASSWORD_HASH=scrypt$32768$8$1$<salt_hex>$<hash_hex>
# MESH_SCRYPT_MAX_CONCURRENCY=2
# MESH_COOKIE_SECURE=true   # 生产 HTTPS（如 Caddy）部署时启用
